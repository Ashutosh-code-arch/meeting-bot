# ─────────────────────────────────────────────────────────────────────────────
# MeetingBot — .env.example
# Copy this file: cp .env.example .env
# Then fill in your values. Lines starting with # are comments.
# ─────────────────────────────────────────────────────────────────────────────


# ── REQUIRED ──────────────────────────────────────────────────────────────────

# HuggingFace token for pyannote speaker diarization.
# 1. Create account at: https://huggingface.co/join
# 2. Get token at:      https://huggingface.co/settings/tokens
#    Click "New token" → name it "meetingbot" → Role: Read → Create
# 3. Accept model terms (all three — required):
#    https://huggingface.co/pyannote/speaker-diarization-3.1
#    https://huggingface.co/pyannote/segmentation-3.0
#    https://huggingface.co/pyannote/embedding
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── WHISPER — transcription model ─────────────────────────────────────────────

# Model size to use for speech-to-text.
# Options (quality vs RAM tradeoff):
#   tiny    — ~390 MB RAM,  fastest,  lowest quality
#   base    — ~740 MB RAM,  fast,     basic quality
#   small   — ~1.5 GB RAM,  good,     decent Hinglish
#   medium  — ~2.5 GB RAM,  great,    use on 8 GB Macs
#   large-v2— ~5.5 GB RAM,  excellent
#   large-v3— ~6.0 GB RAM,  best,     recommended on 16 GB+ Macs
WHISPER_MODEL=large-v3

# Language code for transcription.
# "hi" handles Hindi + Hinglish + English code-switching best.
# "en" for English-only meetings.
# Full list: https://github.com/openai/whisper#available-models-and-languages
WHISPER_LANG=hi


# ── OLLAMA — local LLM for summarization ──────────────────────────────────────

# Which Ollama model to use for generating the 10-section report.
# Options:
#   llama3.1:8b   — 4.7 GB,  fast (~3-5 min),  32k context,  good quality
#   llama3.1:70b  — 40 GB,   slower (~15 min), 128k context, best quality
#   mistral:7b    — 4.1 GB,  fast,              8k context,   alternative
#   gemma2:9b     — 5.4 GB,  fast,              8k context,   alternative
# Download with: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# Ollama server URL.
# Default works when started with: brew services start ollama
OLLAMA_URL=http://localhost:11434

# LLM context window in tokens.
# Must match your model's actual capability:
#   llama3.1:8b  → 32768
#   llama3.1:70b → 131072
#   mistral:7b   → 8192
OLLAMA_CTX=32768

# Max tokens the LLM will generate in a single response.
# 4096 is enough for a full 10-section report.
OLLAMA_MAX_TOKENS=4096

# Temperature: 0.0 = fully deterministic, 1.0 = creative.
# Keep at 0.1 for meeting reports — you want factual, not creative.
OLLAMA_TEMPERATURE=0.1


# ── AUDIO DEVICES ─────────────────────────────────────────────────────────────

# Partial name of the virtual audio capture device (case-insensitive).
# After installing BlackHole, run this to find the exact name:
#   source .venv/bin/activate && python -m meetingbot.audio_devices
# Default "BlackHole" matches "BlackHole 2ch" automatically.
SYSTEM_DEVICE=BlackHole

# Partial name of your microphone input device (case-insensitive).
# Run python -m meetingbot.audio_devices and look for your mic.
# Common values:
#   MacBook       — Built-in MacBook microphone
#   Built-in      — Same as above
#   AirPods       — AirPods mic
#   Jabra         — Jabra headset
#   Rode          — Rode USB mic
MIC_DEVICE=MacBook


# ── STORAGE ───────────────────────────────────────────────────────────────────

# Root directory where all meeting data is stored.
# Subdirectories created automatically:
#   $MEETINGBOT_DIR/audio/    — raw WAV chunks during recording
#   $MEETINGBOT_DIR/reports/  — final Markdown + HTML reports
#   $MEETINGBOT_DIR/meetingbot.db — SQLite job queue + meeting index
MEETINGBOT_DIR=~/meetings


# ── ADVANCED (safe to leave as defaults) ──────────────────────────────────────

# Max characters of transcript sent to LLM in a single call.
# Transcripts longer than this trigger the map-reduce chunking strategy.
# Rough guide: 60000 chars ≈ 45 minutes of meeting at average speaking pace.
# If using llama3.1:70b (128k context), raise this to 120000.
MAX_TRANSCRIPT_CHARS=60000

# Audio chunk size in seconds.
# Whisper is called once per chunk. 30s is the sweet spot:
#   too short → many small files, more overhead
#   too long  → lose more data if a crash happens
CHUNK_SECONDS=30

# Sample rate for audio capture and Whisper transcription.
# Whisper requires 16000 Hz. Do not change this.
SAMPLE_RATE=16000

# Speaker name overrides — optional.
# If your team has recurring meetings with the same people,
# pre-map speaker labels to real names here.
# Note: SPEAKER_00 is whoever speaks FIRST in the meeting — it
# can vary between calls for the same people.
# Leave blank to use auto-labels (SPEAKER_00, SPEAKER_01, etc.)
SPEAKER_00_NAME=
SPEAKER_01_NAME=
SPEAKER_02_NAME=
SPEAKER_03_NAME=
