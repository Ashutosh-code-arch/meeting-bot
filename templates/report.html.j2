{# templates/report.html.j2 — full dark-theme report template #}
<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<style>
:root{--bg:#0d0f12;--bg2:#141720;--bg3:#1c2030;--text:#e8eaf0;--text2:#9aa0b8;
      --text3:#5c6280;--purple:#8b7cf8;--teal:#34d399;--amber:#fbbf24;--blue:#60a5fa;
      --border:rgba(255,255,255,0.08)}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:system-ui,sans-serif;
     font-size:15px;line-height:1.75}
.hdr{background:var(--bg2);border-bottom:1px solid var(--border);
     padding:1.5rem 2rem;position:sticky;top:0;z-index:10}
.hdr h1{font-size:1.3rem;color:var(--purple)}
.hdr-meta{font-size:.82rem;color:var(--text3);margin-top:.2rem}
.wrap{max-width:900px;margin:0 auto;padding:2rem}
h2{color:var(--teal);border-bottom:1px solid var(--border);padding-bottom:.4rem;margin:2rem 0 1rem}
h3{color:var(--amber);margin:1.25rem 0 .5rem}h4{color:var(--text2);margin:1rem 0 .3rem}
p{margin-bottom:.75rem}ul,ol{margin:.5rem 0 .75rem 1.5rem}li{margin-bottom:.25rem}
table{border-collapse:collapse;width:100%;margin:1rem 0;font-size:.88rem}
th{background:var(--bg3);color:var(--text2);padding:.5rem .75rem;text-align:left;
   font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid var(--border)}
td{padding:.55rem .75rem;border-bottom:1px solid var(--border);vertical-align:top}
tr:hover td{background:var(--bg2)}
code{background:var(--bg3);border-radius:4px;padding:2px 6px;font-size:.86em;font-family:monospace}
pre{background:var(--bg2);border:1px solid var(--border);border-radius:8px;
    padding:1rem 1.25rem;overflow-x:auto;margin:1rem 0}
pre code{background:none;padding:0}
blockquote{border-left:3px solid var(--purple);margin:1rem 0;
           padding:.5rem 1rem;background:var(--bg2);border-radius:0 8px 8px 0}
strong{color:var(--text);font-weight:600}a{color:var(--blue);text-decoration:none}
a:hover{text-decoration:underline}
.footer{text-align:center;font-size:.75rem;color:var(--text3);
        margin-top:3rem;padding:1rem;border-top:1px solid var(--border)}
</style></head><body>
<div class="hdr">
  <h1>{{ title }}</h1>
  <div class="hdr-meta">{{ date }} &middot; {{ duration }} &middot; Meeting #{{ meeting_id }}</div>
</div>
<div class="wrap">{{ content }}</div>
<div class="footer">MeetingBot &middot; Local &middot; No data left this machine</div>
</body></html>