# ── SECRETS — never commit these ──────────────────────────────
.env
*.pem
*.key


# ── MEETING DATA — stays on your machine only ─────────────────
# Raw audio chunks
meetings/audio/
~/meetings/

# Generated reports
meetings/reports/

# SQLite job queue and meeting index
meetings/meetingbot.db
meetings/meetingbot.db-wal
meetings/meetingbot.db-shm

# Log files from launchd
meetings/*.log
meetings/*.error.log


# ── ML MODEL CACHES — large, re-downloadable ──────────────────
# Whisper models (~3 GB each)
~/.cache/whisper/

# HuggingFace / pyannote models (~1.5 GB)
~/.cache/huggingface/

# Torch MPS / CUDA cache
~/.cache/torch/


# ── PYTHON ────────────────────────────────────────────────────
# Virtual environment
.venv/
venv/
env/

# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# pytest cache
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# mypy / ruff / type checkers
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json


# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems


# ── EDITORS ───────────────────────────────────────────────────
# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, etc.)
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
*#
.#*


# ── TEST FIXTURES — keep sample WAV out of git ────────────────
# Auto-generated by conftest.py — not needed in repo
tests/fixtures/sample.wav
tests/fixtures/*.wav

# But keep the fixtures directory itself
!tests/fixtures/.gitkeep


# ── LAUNCHD PLISTS WITH REAL PATHS ───────────────────────────
# These get your username baked in by install_launchd.sh
# The templates (without YOUR_USERNAME) are safe to commit
# The installed copies in ~/Library/LaunchAgents/ are not in this repo


# ── MISC ──────────────────────────────────────────────────────
# Temporary files
*.tmp
*.temp
*.bak
*.orig

# Jupyter notebooks (if you experiment in notebooks)
.ipynb_checkpoints/
*.ipynb

# ffmpeg temp files
*.list.txt
